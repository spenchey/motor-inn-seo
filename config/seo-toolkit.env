# seo-toolkit.env — config for scripts/run-seo-toolkit.sh (MOT-2431)
#
# CUTOVER: when the new website goes live, change SEO_TOOLKIT_URL to
# https://www.motorinnautogroup.com — nothing else needs to change.
#
# No secrets belong in this file (it is committed).

SEO_TOOLKIT_URL="https://motorinn-website.vercel.app"

# Brand identity for the monthly brand-mention scan (brand presence is
# domain-independent, so this stays on the production identity).
SEO_TOOLKIT_BRAND="Motor Inn Auto Group"
SEO_TOOLKIT_BRAND_DOMAIN="motorinnautogroup.com"
