        {
          "@type": "Question",
          "name": "Which car dealerships are in Carroll, Iowa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Motor Inn Auto Group is a car dealership at 1526 Le Clark Road in Carroll, Iowa. It runs two franchised stores at that address, Motor Inn Toyota of Carroll and Motor Inn Chevrolet of Carroll. Shoppers can compare new Toyota and Chevrolet vehicles and used cars of any brand in one visit. The phone number is (712) 792-5000."
          }
        },
        {
          "@type": "Question",
          "name": "Where is the car dealership in Carroll, IA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Motor Inn Auto Group is at 1526 Le Clark Road, Carroll, IA 51401, just off West US Highway 30. Sales hours are Monday through Wednesday 8:00 a.m. to 5:30 p.m., Thursday 8:00 a.m. to 7:00 p.m., Friday 8:00 a.m. to 5:30 p.m. and Saturday 8:00 a.m. to 3:00 p.m. The dealership is closed on Sunday."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a Chevy dealer and a Toyota dealer in Carroll, Iowa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Motor Inn Toyota of Carroll and Motor Inn Chevrolet of Carroll both operate at 1526 Le Clark Road in Carroll, Iowa. Shoppers can compare a new Toyota and a new Chevrolet on the same visit. Both stores can be reached at (712) 792-5000."
          }
        },
        {
          "@type": "Question",
          "name": "Can I trade in my car at a Carroll dealership without an appointment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Motor Inn Auto Group in Carroll, Iowa, appraises trade-ins on a walk-in basis, so no appointment is needed. Shoppers can also start a trade value online on the dealership's trade page before they visit."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get car financing at a dealership in Carroll, Iowa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Motor Inn Auto Group in Carroll works with a network of lenders to set up financing on new and used vehicles. Shoppers can bring a payment range, and the team will go through the options with them. Call (712) 792-5000 to start."
          }
        }
